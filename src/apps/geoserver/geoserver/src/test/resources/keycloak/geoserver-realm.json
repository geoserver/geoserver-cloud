{
  "realm": "geoserver",
  "enabled": true,
  "sslRequired": "none",
  "roles": {
    "realm": [
      {
        "name": "wms-reader",
        "description": "Reads the WMS capabilities in the integration tests"
      }
    ]
  },
  "clients": [
    {
      "clientId": "geoserver",
      "name": "GeoServer Cloud",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "geoserver-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "*"
      ],
      "webOrigins": [
        "*"
      ]
